# For `npm run dev` / `vite preview`: copy to .env.local. Do not commit .env*.
#
# Used only as a build-time fallback — in Docker/EKS and S3/CloudFront
# deployments the API URL is instead injected at runtime via public/config.js
# (see README.md).
VITE_API_URL=http://127.0.0.1:8080

# For `docker compose up` (copy to .env instead): the backend URL your
# *browser* will call, and the host port to publish the container on.
API_URL=http://127.0.0.1:8080
WEB_PORT=3000
